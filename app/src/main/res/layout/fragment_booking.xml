<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ✅ GRADIENT HEADER (Navbar Biru) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_gradient_header"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buat Antrian Baru"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lengkapi formulir di bawah untuk membuat antrian"
                android:textColor="#E0FFFFFF"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- CONTENT PADDING -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ProgressBar -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- ========================================= -->
            <!-- ✅ BLOCKED STATE LAYOUT -->
            <!-- ========================================= -->
            <LinearLayout
                android:id="@+id/layout_booking_blocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:gravity="center">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_queue_alert"
                    android:layout_marginBottom="24dp"
                    android:contentDescription="Queue Alert" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Booking Tidak Tersedia"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/error_red"
                            android:gravity="center"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Anda Sudah Memiliki Antrian Aktif"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:id="@+id/tv_blocked_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Silakan selesaikan antrian Anda terlebih dahulu."
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btn_view_queue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LIHAT ANTRIAN SAYA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="16dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@android:color/white" />

            </LinearLayout>

            <!-- ========================================= -->
            <!-- ✅ BOOKING FORM CARD -->
            <!-- ========================================= -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layout_booking_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Nama Pasien -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nama Pasien"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/et_patient_name"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="John Doe"
                        android:inputType="textPersonName"
                        android:padding="12dp"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginBottom="16dp" />

                    <!-- Layanan Klinik -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Layanan Klinik"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spinner_specialization"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/spinner_background"
                        android:layout_marginBottom="16dp" />

                    <!-- Pilih Dokter -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pilih Dokter"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spinner_doctor"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/spinner_background"
                        android:layout_marginBottom="16dp" />

                    <!-- Tanggal -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tanggal"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btn_select_date"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="PILIH TANGGAL"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/purple_500"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_selected_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2025-12-10"
                        android:textSize="14sp"
                        android:textColor="@color/colorAccent"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp" />

                    <!-- Pilih Jam -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pilih Jam"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spinner_time"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/spinner_background"
                        android:layout_marginBottom="16dp" />

                    <!-- Keluhan Awal -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Jelaskan Keluhan Anda"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/et_complaint"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="Jelaskan keluhan Anda..."
                        android:inputType="textMultiLine"
                        android:gravity="top"
                        android:padding="12dp"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginBottom="24dp" />

                    <!-- Confirm Button -->
                    <Button
                        android:id="@+id/btn_confirm_booking"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="KONFIRMASI BOOKING"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/colorPrimary"
                        android:textColor="@android:color/white" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
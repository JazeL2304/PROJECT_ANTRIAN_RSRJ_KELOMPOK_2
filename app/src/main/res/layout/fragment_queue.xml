<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 🎨 GRADIENT HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_gradient_header"
            android:padding="20dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status Antrian"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_doctor_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Ahmad Santoso - Dokter Umum\nJumat, 28 Nov 2025 | 11:12 WITA"
                android:textColor="#E0FFFFFF"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"/>

        </LinearLayout>

        <!-- CONTENT AREA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 🎫 Current Queue Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nomor Antrian Saat Ini"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tv_current_queue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8"
                        android:textSize="64sp"
                        android:textStyle="bold"
                        android:textColor="#00897B"
                        android:layout_gravity="center_horizontal"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 🎫 My Queue Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_my_queue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#E8F5E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nomor Antrian Saya"
                                android:textSize="14sp"
                                android:textColor="#2E7D32"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:id="@+id/tv_my_queue_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No. 15"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="#1B5E20"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_my_queue_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Menunggu"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"/>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#C8E6C9"
                        android:layout_marginBottom="16dp"/>

                    <!-- Estimated Time -->
                    <TextView
                        android:id="@+id/tv_estimated_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Estimasi: 70 menit (10 pasien di depan Anda)"
                        android:textSize="14sp"
                        android:textColor="#2E7D32"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 🔄 Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/btn_refresh"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Refresh"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#00897B"
                    android:background="@drawable/btn_outline_teal"
                    android:elevation="2dp"/>

                <Button
                    android:id="@+id/btn_download_receipt"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Struk"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_solid_teal"
                    android:elevation="2dp"/>

            </LinearLayout>

            <!-- ✅ Complete Button -->
            <Button
                android:id="@+id/btn_complete_queue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Selesai - Pindah ke Riwayat"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/btn_solid_teal"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:visibility="gone"/>

            <!-- ❌ Cancel Button -->
            <Button
                android:id="@+id/btn_cancel_queue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Batalkan Antrian"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/btn_solid_red"
                android:layout_marginBottom="20dp"
                android:elevation="2dp"/>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:visibility="gone"/>

            <!-- 📋 Queue List Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Daftar Antrian Hari Ini"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tv_queue_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading..."
                        android:textSize="13sp"
                        android:textColor="#616161"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="monospace"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>